    ... on Repl {
      id
      authUsers(
        count: $count
        after: $after
        orderBy: $orderBy
        filter: $filter
        clerkEnvironment: $clerkEnvironment
      ) {
        items {
          id
          banned
          timeCreated
          lastLoggedIn
          displayName
          image
          email
          externalId
          userId
          userIdString
        }
        pageInfo {
          hasNextPage
          nextCursor
        }
      }
    }
  }
}
