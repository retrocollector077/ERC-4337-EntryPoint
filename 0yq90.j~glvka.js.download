    query HostingDeploymentSettings($id: String!) {
  hostingDeployment(id: $id) {
    ... on HostingDeployment {
      id
      ...HostingDeploymentDomainsHostingDeployment
      repl {
        id
        org {
          id
        }
      }
      currentBuild {
        id
        provider
        suspendedReason
        machineConfiguration {
          ...MachineConfiguration
        }
        machineJob {
          ... on HostingBuildMachineJob {
            failureNotifications
          }
        }
        envVars {
          name
          value
        }
      }
    }
  }
}
    ${r.HostingDeploymentDomainsHostingDeploymentFragmentDoc}
