    `,a=t.gql`
    mutation PrepareExpoLaunch($input: PrepareExpoLaunchInput!) {
  prepareExpoLaunch(input: $input) {
    ... on PendingExpoLaunchSession {
      failed
    }
    ... on UserError {
      message
    }
    ... on NotFoundError {
      message
    }
    ... on UnauthorizedError {
      message
    }
  }
}
    `,u=t.gql`
    query ExpoLaunchSession($replId: String!, $hostingBuildId: String, $artifactId: String) {
  getRepl(id: $replId) {
    ... on Repl {
      id
      expoLaunch(hostingBuildId: $hostingBuildId, artifactId: $artifactId) {
        ... on ExpoLaunchSession {
          id
          authedLaunchUrl
          expiresAt
          hostingBuildId
          hostingDeploymentId
          framework
          launches {
            ios {
              ...ExpoLaunch
            }
          }
        }
