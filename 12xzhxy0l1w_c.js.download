    fragment DeploymentAuthorizations on Repl {
  id
  authorizations {
    createAutoscaleDeployment: createDeployment(
      provider: cloud_run
      isPrivate: false
    ) {
      ...DeploymentAuthorization
    }
    createAutoscaleDeploymentPrivate: createDeployment(
      provider: cloud_run
      isPrivate: true
    ) {
      ...DeploymentAuthorization
    }
    createRvmDeployment: createDeployment(provider: gce, isPrivate: false) {
      ...DeploymentAuthorization
    }
    createRvmDeploymentPrivate: createDeployment(provider: gce, isPrivate: true) {
      ...DeploymentAuthorization
    }
    createScheduledDeployment: createDeployment(provider: cron, isPrivate: false) {
      ...DeploymentAuthorization
    }
    createStaticDeployment: createDeployment(provider: static, isPrivate: false) {
      ...DeploymentAuthorization
    }
    createStaticDeploymentPrivate: createDeployment(
      provider: static
      isPrivate: true
    ) {
      ...DeploymentAuthorization
    }
    redeployAutoscaleDeployment: redeployDeployment(
      provider: cloud_run
      isPrivate: false
    ) {
      ...DeploymentAuthorization
    }
    redeployAutoscaleDeploymentPrivate: redeployDeployment(
      provider: cloud_run
      isPrivate: true
    ) {
      ...DeploymentAuthorization
    }
    redeployRvmDeployment: redeployDeployment(provider: gce, isPrivate: false) {
      ...DeploymentAuthorization
    }
    redeployRvmDeploymentPrivate: redeployDeployment(provider: gce, isPrivate: true) {
      ...DeploymentAuthorization
    }
    redeployScheduledDeployment: redeployDeployment(
      provider: cron
      isPrivate: false
    ) {
      ...DeploymentAuthorization
    }
    redeployStaticDeployment: redeployDeployment(provider: static, isPrivate: false) {
      ...DeploymentAuthorization
    }
    redeployStaticDeploymentPrivate: redeployDeployment(
      provider: static
      isPrivate: true
    ) {
      ...DeploymentAuthorization
    }
    createDatabricksAppDeployment: createDeployment(
      provider: databricks_app
      isPrivate: false
    ) {
      ...DeploymentAuthorization
    }
    redeployDatabricksAppDeployment: redeployDeployment(
      provider: databricks_app
      isPrivate: false
    ) {
      ...DeploymentAuthorization
    }
    useDeploymentDebugSummaries {
      ...DeploymentAuthorization
    }
    useFreeTierCloudServices {
      ...DeploymentAuthorization
    }
    enableUptimeMonitoring {
      ...DeploymentAuthorization
    }
  }
}
    ${c}`,m=t.gql`
    fragment DeploymentSessionRepl on Repl {
  id
  __typename
  slug
  lastUsedSubdomain
  suggestedUniqueSubdomain
  config {
    isVnc
  }
  source {
    release {
      repl {
        title
      }
    }
  }
  org {
    ...DeploymentSessionOrg
  }
  owner {
    __typename
    ... on User {
      id
      username
    }
    ... on Team {
      id
      username
    }
  }
  hostingDeployment {
    ... on HostingDeployment {
      ...DeploymentSessionHostingDeployment
    }
    ... on Error {
      message
    }
  }
  hostingDeploymentPermissions {
    hasNeonProductionDatabasesEnabled
  }
  ...DeploymentAuthorizations
}
    ${u}
${d}
${p}`,f=t.gql`
    query DeploymentSession($replId: String!) {
  getRepl(id: $replId) {
    ... on Repl {
      id
      ...DeploymentSessionRepl
    }
    ... on Error {
      message
    }
  }
  currentUser {
    ...DeploymentSessionCurrentUser
  }
}
    ${m}
${l}`,g=t.gql`
    subscription DeploymentSessionBuildDeployActionUpdates($input: HostingBuildDeployActionUpdatesInput!) {
  hostingBuildDeployActionUpdates(input: $input) {
    ... on HostingBuildDeployLogAction {
      log
    }
    ... on HostingBuildDeployStatusAction {
      status
      message
      debugSummary {
        ...BuildDebugSummary
      }
      build {
        id
        artifacts {
          ...HostingBuildArtifactFields
        }
      }
    }
  }
}
