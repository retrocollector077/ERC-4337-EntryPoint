        ...CurrentBuild2
      }
      targetDeployment {
        ...TargetHostingDeployment
      }
      targetDatabase {
        ...WorkspaceNeonDatabase
      }
    }
    ... on Error {
      message
    }
  }
}
    ${a.CurrentBuild2FragmentDoc}
${a.TargetHostingDeploymentFragmentDoc}
