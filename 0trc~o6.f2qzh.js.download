    query ReplEnvironmentDesktop($replId: String!, $environment: KeybindingsEnvironmentEnum!, $platform: KeybindingsPlatformEnum!) {
  getRepl(id: $replId) {
    ... on Repl {
      id
      ...ReplEnvironmentDesktopRepl
    }
    ... on ReplOrgPermissionDeniedError {
