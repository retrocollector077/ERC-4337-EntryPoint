    query HostingDeploymentLogs2($replId: String!, $deploymentId: String!, $executionId: String, $start: DateTime, $end: DateTime, $message: String, $level: LogLevel, $limit: Int) {
  getRepl(id: $replId) {
    ... on Repl {
      id
      __typename
      hostingDeploymentLogs(
        deploymentId: $deploymentId
        executionId: $executionId
        start: $start
        end: $end
        message: $message
        level: $level
        limit: $limit
      ) {
        ... on ReplLogs {
          result {
            ...ReplLogLine2
          }
        }
        ... on NotFoundError {
          message
        }
        ... on ServiceUnavailable {
          message
        }
      }
    }
    ... on Error {
      message
    }
  }
}
